{
	"name": "CSS",
	"description": "CSS at-rules, common layouts and every property in IDEPlus' CSS syntax.",
	"clips": [
		{"title": "@media", "body": "@media (max-width: {{cursor}}px) {\n\t\n}"},
		{"title": "@keyframes", "body": "@keyframes {{cursor}} {\n\tfrom {\n\t\t\n\t}\n\tto {\n\t\t\n\t}\n}"},
		{"title": "@import", "body": "@import url(\"{{cursor}}\");"},
		{"title": "@font-face", "body": "@font-face {\n\tfont-family: \"{{cursor}}\";\n\tsrc: url(\"\") format(\"woff2\");\n}"},
		{"title": "flex: centre", "body": "display: flex;\njustify-content: center;\nalign-items: center;"},
		{"title": "grid: columns", "body": "display: grid;\ngrid-template-columns: repeat({{cursor}}, 1fr);\ngap: 1rem;"},
