{
	"name": "HTML elements",
	"description": "Every HTML5 element. Double-click to insert; the cursor lands where you type next.",
	"clips": [
		{"title": "<!-- comment -->", "body": "<!-- {{cursor}} -->"},
		{"title": "<!DOCTYPE html>", "body": "<!DOCTYPE html>"},
		{"title": "a", "body": "<a href=\"{{cursor}}\"></a>"},
		{"title": "abbr", "body": "<abbr title=\"{{cursor}}\"></abbr>"},
		{"title": "address", "body": "<address>{{cursor}}</address>"},
		{"title": "area", "body": "<area shape=\"{{cursor}}\" coords=\"\" href=\"\" alt=\"\">"},
		{"title": "article", "body": "<article>\n\t{{cursor}}\n</article>"},
		{"title": "aside", "body": "<aside>\n\t{{cursor}}\n</aside>"},
		{"title": "audio", "body": "<audio src=\"{{cursor}}\" controls>\n\t\n</audio>"},
		{"title": "b", "body": "<b>{{cursor}}</b>"},
