{
	"name": "Rust",
	"extensions": ["rs"],
	"patterns": [
		{"color": "comment", "regex": "/\\*[\\s\\S]*?(?:\\*/|\\z)"},
		{"color": "comment", "regex": "//[^\\n]*"},
		{"color": "string", "regex": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?"},
		{"color": "string", "regex": "'(?:\\\\.|[^'\\\\\\n])'"},
		{"color": "preprocessor", "regex": "#!?\\[[^\\]\\n]*\\]"},
		{"color": "preprocessor", "regex": "\\b\\w+!"},
		{"color": "keyword", "regex": "\\b(?:as|async|await|break|const|continue|crate|dyn|else|enum|extern|false|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|true|type|unsafe|use|where|while)\\b"},
		{"color": "type", "regex": "\\b(?:i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String|Vec|Option|Result|Box|Some|None|Ok|Err)\\b"},
		{"color": "number", "regex": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)[uUlLfFnm]*\\b"}
	],
	"commentToggle": {"line": "//", "block": ["/*", "*/"]}
}
