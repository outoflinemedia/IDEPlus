{
	"name": "PHP",
	"extensions": ["php", "phtml", "php3", "php4", "php5", "inc"],
	"caseSensitive": false,
	"delimiters": ",(){}[]-+*%/=\"'~!&|<>?:;.^#@$`\\",
	"lineComments": ["//", "#"],
	"blockComments": [["/*", "*/"]],
	"quotes": ["'", "\""],
	"escape": "\\",
	"multilineStrings": true,
	"keywordGroups": [
		{
			"name": "Keywords",
			"color": "keyword",
			"words": [
				"__CLASS__", "__DIR__", "__FILE__", "__FUNCTION__", "__halt_compiler", "__LINE__", "__METHOD__",
				"__NAMESPACE__", "__TRAIT__", "abstract", "and", "array", "as", "bool", "break", "callable", "case",
				"catch", "class", "clone", "const", "continue", "declare", "default", "die", "do", "echo", "else",
				"elseif", "empty", "enddeclare", "endfor", "endforeach", "endif", "endswitch", "endwhile", "enum",
				"eval", "exit", "extends", "false", "final", "finally", "float", "fn", "for", "foreach", "function",
				"global", "goto", "if", "implements", "include", "include_once", "instanceof", "insteadof", "int",
				"interface", "isset", "iterable", "list", "match", "mixed", "namespace", "never", "new", "null",
				"object", "or", "parent", "print", "private", "protected", "public", "readonly", "require",
				"require_once", "return", "self", "static", "string", "switch", "throw", "trait", "true", "try",
				"unset", "use", "var", "void", "while", "xor", "yield"
			]
		},
		{
			"name": "Core functions",
			"color": "type",
			"words": [
				"abs", "addslashes", "array_chunk", "array_column", "array_combine", "array_diff", "array_diff_key",
				"array_fill", "array_fill_keys", "array_filter", "array_flip", "array_intersect",
				"array_intersect_key", "array_key_exists", "array_key_first", "array_key_last", "array_keys",
				"array_map", "array_merge", "array_merge_recursive", "array_pad", "array_pop", "array_product",
				"array_push", "array_rand", "array_reduce", "array_reverse", "array_search", "array_shift",
				"array_slice", "array_splice", "array_sum", "array_unique", "array_unshift", "array_values",
				"array_walk", "arsort", "asort", "assert", "base64_decode", "base64_encode", "base_convert",
				"basename", "bin2hex", "bindec", "boolval", "call_user_func", "call_user_func_array", "ceil",
				"checkdate", "chmod", "chr", "class_exists", "closedir", "compact", "constant", "copy", "count",
				"crc32", "current", "date", "date_default_timezone_get", "date_default_timezone_set", "decbin",
				"dechex", "define", "defined", "dirname", "end", "error_log", "error_reporting", "exp", "explode",
				"extract", "fclose", "feof", "fflush", "fgetcsv", "fgets", "file", "file_exists", "file_get_contents",
				"file_put_contents", "filemtime", "filesize", "filter_input", "filter_var", "floatval", "floor",
				"flush", "fmod", "fopen", "fputcsv", "fputs", "fread", "func_get_args", "func_num_args",
				"function_exists", "fwrite", "get_class", "get_object_vars", "get_parent_class", "getenv", "gettype",
				"glob", "gmdate", "hash", "hash_hmac", "header", "headers_sent", "hex2bin", "hexdec", "hrtime",
				"html_entity_decode", "htmlentities", "htmlspecialchars", "htmlspecialchars_decode",
				"http_build_query", "http_response_code", "iconv", "implode", "in_array", "ini_get", "ini_set",
				"intdiv", "interface_exists", "intval", "is_array", "is_bool", "is_callable", "is_dir", "is_file",
				"is_finite", "is_float", "is_int", "is_integer", "is_iterable", "is_nan", "is_null", "is_numeric",
				"is_object", "is_readable", "is_string", "is_writable", "join", "json_decode", "json_encode",
				"json_last_error", "json_last_error_msg", "key", "krsort", "ksort", "lcfirst", "log", "log10", "ltrim",
				"mail", "max", "mb_str_split", "mb_strlen", "mb_strpos", "mb_strtolower", "mb_strtoupper", "mb_substr",
				"md5", "method_exists", "microtime", "min", "mkdir", "mktime", "mt_rand", "mysqli_close",
				"mysqli_connect", "mysqli_error", "mysqli_fetch_array", "mysqli_fetch_assoc", "mysqli_insert_id",
				"mysqli_num_rows", "mysqli_query", "mysqli_real_escape_string", "natcasesort", "natsort", "next",
				"nl2br", "number_format", "ob_end_clean", "ob_get_clean", "ob_get_contents", "ob_start", "octdec",
				"opendir", "ord", "parse_str", "parse_url", "password_hash", "password_verify", "pathinfo", "phpinfo",
				"phpversion", "pi", "pow", "preg_grep", "preg_match", "preg_match_all", "preg_quote", "preg_replace",
				"preg_replace_callback", "preg_split", "prev", "print_r", "printf", "property_exists", "putenv",
				"rand", "random_bytes", "random_int", "range", "rawurldecode", "rawurlencode", "readdir", "realpath",
				"rename", "reset", "rmdir", "round", "rsort", "rtrim", "scandir", "serialize", "session_destroy",
				"session_id", "session_regenerate_id", "session_start", "set_error_handler", "set_exception_handler",
				"setcookie", "settype", "sha1", "shuffle", "sizeof", "sleep", "sort", "spl_autoload_register",
				"sprintf", "sqrt", "str_contains", "str_ends_with", "str_ireplace", "str_pad", "str_repeat",
				"str_replace", "str_split", "str_starts_with", "strcasecmp", "strcmp", "strip_tags", "stripos",
				"stripslashes", "stristr", "strlen", "strncasecmp", "strncmp", "strpos", "strrchr", "strrev",
				"strrpos", "strstr", "strtolower", "strtotime", "strtoupper", "strval", "substr", "substr_count",
				"sys_get_temp_dir", "tempnam", "time", "touch", "trigger_error", "trim", "uasort", "ucfirst",
				"ucwords", "uksort", "uniqid", "unlink", "unserialize", "urldecode", "urlencode", "usleep", "usort",
				"var_dump", "var_export", "vsprintf", "wordwrap"
			]
		},
		{
			"name": "Built-in classes",
			"color": "type",
			"words": [
				"ArgumentCountError", "ArithmeticError", "ArrayAccess", "ArrayIterator", "ArrayObject", "Closure",
				"Countable", "DateInterval", "DatePeriod", "DateTime", "DateTimeImmutable", "DateTimeZone",
				"DivisionByZeroError", "DomainException", "Error", "ErrorException", "Exception", "Generator",
				"InvalidArgumentException", "Iterator", "IteratorAggregate", "JsonSerializable", "LengthException",
				"LogicException", "mysqli", "mysqli_result", "OutOfRangeException", "OverflowException", "PDO",
				"PDOException", "PDOStatement", "RangeException", "RuntimeException", "SplObjectStorage", "SplQueue",
				"SplStack", "stdClass", "Stringable", "Throwable", "Traversable", "TypeError", "UnderflowException",
				"UnexpectedValueException", "ValueError"
			]
		}
	],
	"prefixes": [{"prefix": "$", "color": "attribute"}, {"prefix": "\\", "color": "preprocessor"}],
	"numbers": true,
	"codeInside": {"language": "HTML / XML", "start": "<\\?(?:php\\b|=)?", "end": "\\?>"},
	"commentToggle": {"line": "//", "block": ["/*", "*/"]}
}
