{
	"name": "SCSS / Sass / Less",
	"extensions": ["scss", "sass", "less"],
	"patterns": [
		{"color": "comment", "regex": "/\\*[\\s\\S]*?(?:\\*/|\\z)"},
		{"color": "comment", "regex": "(?<!:)//[^\\n]*"},
		{"color": "string", "regex": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?"},
		{"color": "string", "regex": "'(?:[^'\\\\\\n]|\\\\.)*'?"},
		{"color": "preprocessor", "regex": "@[\\w-]+"},
		{"color": "number", "regex": "#[0-9a-fA-F]{3,8}\\b"},
		{"color": "attribute", "regex": "(?<=[{;\\s])[\\w-]+(?=\\s*:[^:])"},
		{"color": "keyword", "regex": "!important\\b"},
		{"color": "number", "regex": "-?\\b\\d+(?:\\.\\d+)?(?:px|em|rem|vh|vw|vmin|vmax|ch|ex|pt|pc|cm|mm|in|deg|rad|turn|s|ms|fr|%)?"},
		{"color": "attribute", "regex": "\\$[\\w-]+"}
	],
	"commentToggle": {"block": ["/*", "*/"]}
}
