{
	"name": "YAML",
	"extensions": ["yml", "yaml"],
	"patterns": [
		{"color": "comment", "regex": "(?<!\\S)#[^\\n]*"},
		{"color": "attribute", "regex": "^[ \\t]*(?:-[ \\t]+)?[\\w.\\-]+(?=[ \\t]*:(?:[ \\t]|$))"},
		{"color": "string", "regex": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?"},
		{"color": "string", "regex": "'(?:[^'\\\\\\n]|\\\\.)*'?"},
		{"color": "keyword", "regex": "\\b(?:true|false|null|yes|no|on|off)\\b"},
		{"color": "number", "regex": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)[uUlLfFnm]*\\b"}
	],
	"commentToggle": {"line": "#"}
}
